---
import Layout from "../layouts/WMBase.astro"; import Breadcrumbs from "../components/Breadcrumbs.astro";
const title = "Reviews | Wellington aluminium window & door repairs"; const description = "Recent customer reviews for single and double-glazed aluminium window and sliding door repairs across Wellington, Porirua and the Hutt Valley.";
const canonical = "https://windowmaintenance.co.nz/reviews/";
---
<Layout title={title} description={description} canonical={canonical}>
  <Breadcrumbs />
  <section class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-3xl font-extrabold">Reviews</h1>
    <p class="mt-3 text-slate-700">What customers have said after aluminium window, ranchslider and lock repairs across the Wellington region.</p>
    <ul class="mt-6 space-y-4">
      <li class="rounded-xl bg-[var(--brand-surface)] p-4 ring-1 ring-slate-200">
        <div class="font-semibold">Matt K.</div>
        <p class="text-slate-700">“Door slides like new. Prompt and professional.”</p>
      </li>
      <li class="rounded-xl bg-[var(--brand-surface)] p-4 ring-1 ring-slate-200">
        <div class="font-semibold">Sarah L.</div>
        <p class="text-slate-700">“Quick to respond and very tidy work. Our windows open and close perfectly now.”</p>
      </li>
      <li class="rounded-xl bg-[var(--brand-surface)] p-4 ring-1 ring-slate-200">
        <div class="font-semibold">James P.</div>
        <p class="text-slate-700">“Turned up on time, explained everything clearly and fixed the problem on the spot.”</p>
      </li>
      <li class="rounded-xl bg-[var(--brand-surface)] p-4 ring-1 ring-slate-200">
        <div class="font-semibold">Aroha T.</div>
        <p class="text-slate-700">“Very happy with the result. Ranchslider is smooth again and no more drafts.”</p>
      </li>
      <li class="rounded-xl bg-[var(--brand-surface)] p-4 ring-1 ring-slate-200">
        <div class="font-semibold">Daniel R.</div>
        <p class="text-slate-700">“Professional service from start to finish. Would happily recommend to friends and whānau.”</p>
      </li>
    </ul>

    <div class="mt-8 rounded-lg bg-[var(--brand-surface)] p-6 ring-1 ring-slate-200">
      <h2 class="text-xl font-bold">More reviews, and leaving your own</h2>
      <p class="mt-2 text-slate-700">You can also read and leave reviews on our <a class="text-blue-600 underline" href="https://www.facebook.com/WindowMaintenanceNZ/" rel="noopener" target="_blank">Facebook page</a>. If we have done work for you recently, a short review genuinely helps other Wellington homeowners find us.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="tel:+6421638205" data-cta="call">Call 021 638 205</a>
        <a class="btn btn-secondary" href="/contact/">Get a fast quote</a>
      </div>
    </div>
  </section>
</Layout>
